# PostgreSQL (docs/decisions/0009-deploiement-gratuit.md) — ex. Render fournit une URL
# du type postgresql://user:password@host/obpmarket?schema=public
DATABASE_URL=""
PORT=3001

# Contrôles anti-fraude sur les relevés (PRI-02, PRI-03, RG-01, RG-03)
PRICE_WINDOW_HOURS=24
PRICE_MIN_READINGS=3
PRICE_MIN_MARKETS=2
PRICE_ANOMALY_THRESHOLD=0.15

# Authentification (CPT-01) — à remplacer par un vrai secret avant la production
JWT_SECRET="change-me"
OTP_TTL_MINUTES=5

# Revente entre clients (REV-07) — taux à confirmer avec la direction, cahier des charges §11
RESALE_COMMISSION_RATE=0.05

# Vendeurs partenaires (VEN-12, RG-15, RG-16) — taux et fourchette à confirmer avec la direction
VENDOR_COMMISSION_RATE=0.08
VENDOR_PRICE_BAND=0.10

# Paiement Mobile Money manuel (docs/decisions/0007-paiement-momo-manuel.md) — flux de
# secours : ces numéros sont juste affichés au client comme destinataires du transfert.
MOMO_MERCHANT_NAME="OBP Market"
MOMO_MTN_NUMBER="01 00 00 00 00"
MOMO_MOOV_NUMBER="01 00 00 00 00"

# Passerelle Nyole (docs/decisions/0008-nyole.md) — af_test_sec_... en développement,
# af_live_sec_... en production. URL de webhook à renseigner dans l'espace Nyole :
# {API_PUBLIC_URL}/webhooks/nyole
NYOLE_SECRET_KEY=""
NYOLE_PUBLIC_KEY=""
NYOLE_API_BASE="https://app.nyole.com/api"
WEB_BASE_URL="http://localhost:3000"
